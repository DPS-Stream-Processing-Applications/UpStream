#!/usr/bin/env bash
set -euo pipefail

if [[ ! -f "$KUBECONFIG" ]]; then
  echo "kubeconfig not found at $KUBECONFIG"
  exit 1
fi

# Replace the server entry with localhost:6443
sed -i.bak -E 's#server: https://[0-9.]+:6443#server: https://localhost:6443#' "$KUBECONFIG"

echo "✔ Kubeconfig patched: server now points to \`https://localhost:6443\`"
